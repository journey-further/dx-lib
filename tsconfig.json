{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declarationMap": true,
    "declarationDir": "./dist/types",
    "esModuleInterop": true,
    "target": "ES6",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "module": "ES6",
    "baseUrl": "src",
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "lib": ["es2015", "dom", "dom.iterable", "ES2022"],
    "skipLibCheck": true
  }
}
