{
  "compilerOptions": {
    "outDir": "./dist",
    "declarationMap": true,
    "declarationDir": "./dist/types",
    "esModuleInterop": true,
    "target": "ES5",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "module": "ES6",
    "baseUrl": "src",
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "lib": ["es2015", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "paths": {
      "modules/*": ["modules/*"],
      "types/*": ["types/*"]
    }
  },
  "include": ["./src", "index.d.ts", "__tests__"]
}
