{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declarationMap": true,
    "esModuleInterop": true,
    "target": "ES6",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "module": "ES2022",
    "baseUrl": "src",
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "lib": ["DOM", "ES2022"],
    "skipLibCheck": true
  }
}
