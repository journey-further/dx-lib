{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declarationMap": true,
    "esModuleInterop": true,
    "target": "ES6",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "module": "ES6",
    "baseUrl": "src",
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "lib": ["es2015", "dom", "dom.iterable"],
    "skipLibCheck": true
  },

  "include": ["./src"],
  "exclude": ["jest.config.ts", "rollup.config.ts"]
}
