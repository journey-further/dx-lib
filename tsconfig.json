{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declarationMap": true,
    "esModuleInterop": true,
    "target": "es2018",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "module": "esnext",
    "baseUrl": "src",
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "lib": ["DOM", "ES2022", "dom.iterable"],
    "skipLibCheck": true
  },
  "exclude": ["__tests__", "node_modules", "dist"]
}
