{
  "name": "jf-lib",
  "version": "1.5.6",
  "main": "dist/index.js",
  "repository": "https://github.com/jf-conversion/jf-lib",
  "author": "Paul Singh",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/declarations/index.d.ts",
  "scripts": {
    "dev": "webpack --watch",
    "dev:build": "yarn prepare --watch",
    "prepare": "yarn --silent build",
    "test": "jest",
    "lint": "eslint src --fix",
    "prettier": "prettier src --write",
    "build": "rm -rf dist && tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
    "release:dry": "node-env-run --exec \"semantic-release --dry-run --debug --no-ci --repositoryUrl \"$(git remote get-url origin | tr -d '\n')\"\"",
    "docs": "yarn index && typedoc",
    "index": "npx run-func ./generateIndex.js init"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/js": "^9.8.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^11.0.1",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@swc/cli": "^0.1.57",
    "@swc/core": "^1.3.7",
    "@swc/jest": "^0.2.23",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^28.1.6",
    "@types/node": "^18.0.6",
    "@types/node-fetch": "^2.6.2",
    "@types/readline-sync": "^1.4.4",
    "@types/shelljs": "^0.8.11",
    "@types/yargs": "^17.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "add": "^2.0.6",
    "conventional-changelog-eslint": "^5.0.0",
    "eslint": "^9.8.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-jf-base": "git+ssh://git@github.com:jf-conversion/eslint-config-jf-base.git#1.0.3",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import-x": "^3.1.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "globals": "^15.9.0",
    "html-loader": "^5.0.0",
    "jest": "^28.1.3",
    "jest-environment-jsdom": "^28.1.3",
    "jf-cro-webpack-hmr": "git+ssh://git@github.com:jf-conversion/jf-cro-webpack-hmr.git#1.0.5",
    "node-env-run": "^4.0.2",
    "prettier": "^3.3.3",
    "prettier-plugin-jsdoc": "^1.3.0",
    "semantic-release": "^22.0.8",
    "ts-jest": "^28.0.7",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.7.0",
    "tslib": "^2.4.0",
    "typedoc": "^0.26.11",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "webpack": "^5.52.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^5.0.4",
    "yarn": "^1.22.19"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "swc-loader": "^0.2.3",
    "typedoc-github-theme": "^0.1.2"
  }
}
