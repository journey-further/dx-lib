{
  "name": "jf-lib",
  "version": "3.0.1",
  "main": "dist/index.js",
  "repository": "https://github.com/journey-further/dx-lib",
  "author": "Paul Singh",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/declarations/index.d.ts",
  "scripts": {
    "dev": "rspack --watch",
    "build:dev": "npm run prepare -- --watch",
    "prepare": "npm run build --silent",
    "test": "vitest run",
    "lint": "eslint src --fix",
    "prettier": "prettier src --write",
    "build": "rm -rf dist && tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
    "build:docs": "npm run index && typedoc",
    "index": "npx run-func ./generateIndex.js init",
    "audit:security": "audit-ci --config ./audit-ci.jsonc"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.4",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9",
    "@rspack/cli": "^2.0.6",
    "@rspack/core": "^2.0.6",
    "@swc/core": "^1.10.7",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^4.1.8",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.4.20",
    "css-loader": "^7.1.2",
    "cssnano": "^7.0.6",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-jsdoc": "^50.6.1",
    "eslint-plugin-node": "^11.1.0",
    "globals": "^15.15.0",
    "html-loader": "^5.1.0",
    "jsdom": "^25.0.1",
    "node-env-run": "^4.0.2",
    "postcss": "^8.5.15",
    "postcss-color-rgba-fallback": "^4.0.0",
    "postcss-loader": "^8.1.1",
    "postcss-media-minmax": "^5.0.0",
    "postcss-mixins": "^10.0.1",
    "postcss-nested": "^6.2.0",
    "postcss-preset-env": "^10.1.3",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-jsdoc": "^1.3.2",
    "sass": "^1.85.0",
    "sass-loader": "^16.0.4",
    "swc-loader": "^0.2.6",
    "tsc-alias": "^1.8.10",
    "typedoc": "^0.28.19",
    "typedoc-github-theme": "^0.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.8"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22",
    "npm": ">=10",
    "yarn": "please-use-npm"
  },
  "dependencies": {},
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss-color-rgba-fallback": {
      "postcss": "^8.5.15"
    }
  }
}
