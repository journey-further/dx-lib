    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-jsdoc": "^50.6.1",
    "globals": "^15.15.0",
    "html-loader": "^5.1.0",
    "jsdom": "^25.0.1",
    "node-env-run": "^4.0.2",
    "postcss": "^8.5.1",
    "postcss-cli": "^11.0.0",
    "postcss-color-rgba-fallback": "^4.0.0",
    "postcss-combine-media-query": "^1.0.1",
    "postcss-custom-media": "^10.0.8",
