{
  "name": "jf-lib",
  "version": "2.0.12-staging.1",
  "main": "dist/index.js",
  "repository": "https://github.com/journey-further/dx-lib",
  "author": "Paul Singh",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/declarations/index.d.ts",
  "scripts": {
    "dev": "yarn rspack --watch",
    "build:dev": "yarn prepare --watch",
    "prepare": "yarn --silent build",
    "test": "vitest run",
    "lint": "eslint src --fix",
    "prettier": "prettier src --write",
    "build": "rm -rf dist && tsc-alias -p tsconfig.prod.json && tsc -p tsconfig.prod.json",
    "release:dry": "node-env-run --exec \"semantic-release --dry-run --debug --no-ci --repositoryUrl \"$(git remote get-url origin | tr -d '\n')\"\"",
    "build:docs": "yarn index && typedoc",
    "index": "npx run-func ./generateIndex.js init",
    "audit:security": "audit-ci --config ./audit-ci.jsonc"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.4",
    "@eslint/eslintrc": "^3.2.0",
