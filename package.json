{
  "name": "jf-lib",
  "version": "1.4.1",
  "main": "dist/index.js",
  "repository": "https://github.com/jf-conversion/jf-lib",
  "author": "Paul Singh",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/declarations/index.d.ts",
  "scripts": {
    "prepare": "yarn --silent build",
    "test": "jest",
    "lint": "eslint src --fix",
    "prettier": "prettier src --write",
    "build": "rm -rf dist && tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
    "release:dry": "node-env-run --exec \"semantic-release --dry-run --debug --no-ci --repositoryUrl \"$(git remote get-url origin | tr -d '\n')\"\"",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^10.0.3",
    "@swc/cli": "^0.1.57",
    "@swc/core": "^1.3.7",
    "@swc/jest": "^0.2.23",
    "@types/jest": "^28.1.6",
    "@types/node": "^18.0.6",
    "@types/node-fetch": "^2.6.2",
    "@types/readline-sync": "^1.4.4",
    "@types/shelljs": "^0.8.11",
    "@types/yargs": "^17.0.10",
    "@typescript-eslint/eslint-plugin": "^5.40.1",
    "@typescript-eslint/parser": "^5.0.0",
    "add": "^2.0.6",
    "conventional-changelog-eslint": "^3.0.9",
    "eslint": "^8.20.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-node": "^4.1.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^3.4.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsdoc": "^39.3.14",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^28.1.3",
    "jest-environment-jsdom": "^28.1.3",
    "node-env-run": "^4.0.2",
    "prettier": "^2.7.1",
    "prettier-plugin-jsdoc": "^0.4.2",
    "semantic-release": "^21.0.1",
    "ts-jest": "^28.0.7",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.7.0",
    "tslib": "^2.4.0",
    "typedoc": "^0.23.15",
    "typescript": "^4.7.4",
    "yarn": "^1.22.19"
  },
  "engines": {
    "node": ">=18"
  }
}
