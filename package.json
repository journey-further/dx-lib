    "sass": "^1.85.0",
    "sass-loader": "^16.0.4",
    "semantic-release": "^24.2.3",
    "swc-loader": "^0.2.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tslib": "^2.8.1",
    "typedoc": "^0.27.7",
    "typedoc-github-theme": "^0.1.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5",
    "yarn": "^1.22.22"
