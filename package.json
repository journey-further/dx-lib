{
  "name": "jf-lib",
  "version": "1.5.1-staging.1",
  "main": "dist/index.js",
  "repository": "https://github.com/jf-conversion/jf-lib",
  "author": "Paul Singh",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/declarations/index.d.ts",
  "scripts": {
    "prepare": "yarn --silent build",
    "test": "jest",
    "lint": "eslint src --fix",
    "prettier": "prettier src --write",
    "build": "rm -rf dist && tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
    "release:dry": "node-env-run --exec \"semantic-release --dry-run --debug --no-ci --repositoryUrl \"$(git remote get-url origin | tr -d '\n')\"\"",
    "docs": "yarn index && typedoc",
    "index": "npx run-func ./generateIndex.js init"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.7.0",
    "@eslint/migrate-config": "^1.1.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.11",
    "@types/node-fetch": "^2.6.11",
    "@types/readline-sync": "^1.4.8",
    "@types/shelljs": "^0.8.15",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "add": "^2.0.6",
    "conventional-changelog-eslint": "^6.0.0",
    "eslint": "^9.7.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-node": "^4.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.8.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.8.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-env-run": "^4.0.2",
    "prettier": "^3.3.3",
    "prettier-plugin-jsdoc": "^1.3.0",
    "semantic-release": "^24.0.0",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tslib": "^2.6.3",
    "typedoc": "^0.26.5",
    "typescript": "^5.5.3",
    "yarn": "^1.22.22"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {}
}
