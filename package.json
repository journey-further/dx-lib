{
  "name": "jf-lib",
  "version": "2.0.10",
  "main": "dist/index.js",
  "repository": "https://github.com/journey-further/dx-lib",
  "author": "Paul Singh",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "dist/declarations/index.d.ts",
  "scripts": {
    "dev": "yarn rspack --watch",
    "build:dev": "yarn prepare --watch",
    "prepare": "yarn --silent build",
    "test": "jest --silent",
    "lint": "eslint src --fix",
    "prettier": "prettier src --write",
    "build": "rm -rf dist && tsc-alias -p tsconfig.prod.json && tsc -p tsconfig.prod.json",
    "release:dry": "node-env-run --exec \"semantic-release --dry-run --debug --no-ci --repositoryUrl \"$(git remote get-url origin | tr -d '\n')\"\"",
    "docs": "yarn index && typedoc",
    "index": "npx run-func ./generateIndex.js init",
    "audit:security": "audit-ci --config ./audit-ci.jsonc"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/js": "^9.8.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@rspack/cli": "^1.3.15",
    "@rspack/core": "^1.3.15",
    "@swc/cli": "^0.1.57",
    "@swc/core": "^1.3.7",
    "@swc/jest": "^0.2.23",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^28.1.6",
    "@types/node": "^18.0.6",
    "@types/node-fetch": "^2.6.2",
    "@types/readline-sync": "^1.4.4",
    "@types/shelljs": "^0.8.11",
    "@types/yargs": "^17.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "add": "^2.0.6",
    "autoprefixer": "^10.3.4",
    "conventional-changelog-eslint": "^6.0.0",
    "css-loader": "^7.1.2",
    "cssnano": "^7.0.4",
    "eslint": "^9.8.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-jf-base": "github:journey-further/eslint-config-dx-base.git",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import-x": "^3.1.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "globals": "^15.9.0",
    "html-loader": "^5.0.0",
    "jest": "^28.1.3",
    "jest-environment-jsdom": "^28.1.3",
    "dx-webpack-hmr": "github:journey-further/dx-webpack-hmr.git",
    "node-env-run": "^4.0.2",
    "postcss": "^8.3.11",
    "postcss-cli": "^11.0.0",
    "postcss-color-rgba-fallback": "^4.0.0",
    "postcss-combine-media-query": "^1.0.1",
    "postcss-custom-media": "^10.0.8",
    "postcss-loader": "^8.1.1",
    "postcss-media-minmax": "^5.0.0",
    "postcss-mixins": "^10.0.1",
    "postcss-nested": "^6.0.1",
    "postcss-preset-env": "^9.6.0",
    "postcss-scss": "^4.0.6",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-jsdoc": "^1.3.0",
    "sass": "^1.58.3",
    "sass-loader": "^16.0.4",
    "semantic-release": "^24.2.3",
    "swiper": "^11.2.1",
    "ts-jest": "^28.0.7",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.7.0",
    "tslib": "^2.4.0",
    "typedoc": "^0.26.11",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "yarn": "^1.22.19"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "swc-loader": "^0.2.3",
    "typedoc-github-theme": "^0.1.2"
  }
}
