{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "declarationDir": "dist/declarations"
  },
  "include": ["src/**/*"],
  "tsc-alias": {
    "resolveFullPaths": true,
    "replacers": {
      "typeDefs": {
        "enabled": true,
        "file": "./replacer.cjs"
      }
    }
  }
}
