{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "tsc-alias": {
    "resolveFullPaths": true,
    "replacers": {
      "typeDefs": {
        "enabled": true,
        "file": "./replacer.cjs"
      },
      "base-url": {
        "enabled": true
      },
      "default": {
        "enabled": true
      }
    }
  }
}
