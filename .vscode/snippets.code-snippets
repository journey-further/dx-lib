  "OBF pollAndExecute": {
    "scope": "javascript",
    "prefix": "pollAndExecute",
    "body": [
      "Test.pageview.suspend(\"waiting for page\");",
      "var pollAndExecute = function(){",
      "",
      "    if( $1 ){",
      "      // Conditions met, proceed",
      "      WT.helpers.bdebug.log(`%c${Config.testAlias}: Conditions met`, \"background: #199bd7; color: #fff; padding: 2px 5px;\")",
      "    } else {",
      "      // Conditions not met, halt the test and show the page",
      "      WT.helpers.bdebug.log(`%c${Config.testAlias}: Conditions not met`, \"background: #c00; color: #fff; padding: 2px 5px;\");",
      "      Test.showHidePage(Config.showPage);",
      "      return false;",
      "    }",
      "",
      "    // Poll the page - this will run constantly until pollTimeout is reached",
      "    Test.poll({",
      "        msg: \"Polling the page\",",
      "        // Poll until the below returns true",
      "        when: function()",
      "        {",
      "            return !!document.querySelector(\"$2\")",
      "        },",
      "        // Then run the following callback",
      "        then: function()",
      "        {",
      "            WT.helpers.bdebug.log(`%c${Config.testAlias}: Success!`, \"background: #0dc05f; color: #fff; padding: 2px 5px;\")",
      "            Test.pageview.track();",
      "            Test.start(\"Rendering\", Test.Render);",
      "            Test.start(\"Tracking\", Test.Tracking);",
      "            Test.showHidePage(Config.showPage);",
      "        },",
      "        pollTimeout: 4000",
      "    });",
      "}",
      "",
      "pollAndExecute();",
      "Test.poll({",
      "    when: function(){ return true },",
      "    then: function(){",
      "        window.addEventListener(\"wt-pagechange\", function(){",
      "            pollAndExecute();",
      "        });",
      "    }",
      "});"
    ]
  },
