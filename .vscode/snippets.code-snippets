  // SCSS mixins
  "SM mixin": {
    "scope": "scss",
    "prefix": "sm",
    "body": [
      "@mixin sm {",
      "\t@media screen and (max-width: $1){",
      "\t\t@content;",
      "\t}",
      "}"
    ],
    "description": "Adds a mixin for small screens"
  },
  "SM use": {
    "scope": "scss",
    "prefix": "smm",
    "body": [
      "@include sm {",
      "\t$1",
      "}"
    ],
    "description": "Use the mixin for small screens"
  },
  "MD mixin": {
    "scope": "scss",
    "prefix": "md",
    "body": [
