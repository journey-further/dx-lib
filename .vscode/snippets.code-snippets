  "Experiment Skeleton": {
    "scope": "javascript",
    "prefix": "skel",
    "body": [
      "const STATE = {",
      "  isObserving: false,",
      "  observer: undefined,",
      "  ticketId: \"\",",
      "  variant: \"\",",
      "};",
      "\n",
      "const watchForDomChanges = () => {",
      "  if (STATE.isObserving) return;",
      "  const target = document.querySelector(\"\");",
      "  const config = {",
      "    childList: true,",
      "    subtree: true,",
      "  };",
      "  const callback = () => {",
      "    disconnectObserver();",
      "    applyChanges();",
      "  };",
      "  if (!STATE.observer) {",
      "    STATE.observer = new MutationObserver(callback);",
      "  }",
      "  STATE.observer.observe(target, config);",
      "  STATE.isObserving = true;",
      "};",
      "\n",
      "const disconnectObserver = () => {",
      "  STATE.observer?.disconnect();",
      "  STATE.observer = undefined;",
      "  STATE.isObserving = false;",
      "};",
      "\n",
      "const applyChanges = () => {",
      "  watchForDomChanges();",
      "};",
      "\n",
      "(() => {",
      "  try {",
      "  } catch (e) {",
      "    console.warn(e);",
      "  } finally {",
      "    window.dataLayer = window.dataLayer || [];",
      "    window.dataLayer.push({",
      "      event: \"Optimize-View\",",
      "      eventAction: `_${STATE.ticketId}`,",
      "      eventLabel: \"_\",",
      "    });",
      "  }",
      "})();"
    ]
  },
  "watchForChanges": {
    "scope": "javascript",
    "prefix": "watch",
    "body": [
      "const watchForChanges = () => {",
      "  if (!!STATE.observer.details.isObserving) return;",
      "  console.log(\"watching for changes\")",
      "  /** @type {Element} The target element to listen for changes to */",
      "  const target = document.querySelector(\"$1\");",
      "  if(!!!target) {",
      "  \tconsole.log(\"no watch target\");",
      "  \treturn;",
      "  };",
      "",
      "  /** @type {MutationObserverInit} The MutationObserver options */",
      "  const config = { childList: true };",
      "",
      "\t/** @type {MutationCallback} The callback */",
      "\tconst callback = (mutations) => {",
      "\t\tmutations.forEach((mutation) => {",
      "\t\t\t// Add your conditions to check the mutation",
      "\t\t\t$2",
      "\t\t})",
      "\t}",
      "",
      "\t/** Trigger the observer */",
      "\tSTATE.observer.observe(target, config, callback)",
      "}"
    ],
    "description": "Wrapper for useMutationObserver"
  },
