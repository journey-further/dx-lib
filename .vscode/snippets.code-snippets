    "body": ["//div[contains(string(), 'Elangovan')]"]
  },
  "Push to GA": {
    "prefix": "pushToDL",
    "body": [
      "window.dataLayer = window.dataLayer || [];",
      "window.dataLayer.push({",
      "  event: \"Optimize-View\",",
      "  eventAction: \"_JFXXX_XXXX\",",
      "  eventLabel: \"_\"",
      "});"
    ]
  },
  "Get parent": {
    "prefix": "pa",
    "body": [
      "function getParents(el, parent){",
      "  if(!!el.parentNode){",
      "     if(el.parentNode.classList.contains(parent) || el.parentNode.tagName === parent.toUpperCase()){ ",
      "       return el.parentNode;",
      "     } else {",
      "       return getParents(el.parentNode, parent);",
      "     }",
      "  }",
      "}"
    ]
  },

  "GHD OneTrustActiveGroups Cookie check": {
    "prefix": "otag",
    "body": " && !!window.OnetrustActiveGroups && /C0002/.test(OnetrustActiveGroups)"
  },

