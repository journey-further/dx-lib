    "prefix": "tcf",
    "body": [
      "try {",
      "\t$1",
      "} catch(error){",
      "\tconsole.warn(error);",
      "} finally {",
      "\twindow.dataLayer = window.dataLayer || [];",
      "\tdataLayer.push({",
      "\t\t\"event\":\"Optimize-View\",",
      "\t\t\"eventAction\":\"$2\",",
      "\t\t\"eventLabel\":\"$3\"",
      "\t});",
      "}"
    ],
    "description": "Insert a try...catch...finally including the DataLayer push"
  }
