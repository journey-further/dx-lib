      "  window.SS && SS.SPA && SS.SPA.dynamicModify({",
      "      \"staticContainer\": \"body\",",
      "      \"dynamicContainer\": \"$1\",",
      "      \"callbackFunction\": function (){",
      "        $2",
      "      },",
      "      \"runCallbackNow\": false,",
      "      \"watchSubtree\": true",
      "  })",
      "} catch(err) {}"
    ]
  },

  "Get element by Xpath": {
    "prefix": "xpathGet",
    "body": [
